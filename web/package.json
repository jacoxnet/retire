{
  "name": "retire-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:update": "UPDATE_FIXTURES=1 vitest run test/plan && UPDATE_FIXTURES=1 vitest run test/deterministic.test.ts test/inputs.test.ts test/montecarlo.test.ts test/mc.test.ts test/stress.test.ts && UPDATE_FIXTURES=1 vitest run",
    "typecheck": "svelte-kit sync && tsc --noEmit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "bench": "vitest run --config vitest.bench.config.ts",
    "bench:browser": "node bench/browser-bench.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.5.1",
    "@playwright/test": "1.56.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.4",
    "bootstrap": "5.3.8",
    "chart.js": "^4.5.1",
    "jsdom": "^29.1.1",
    "marked": "^18.1.0",
    "playwright-core": "1.56",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
